[TEMPLATE]
# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# Rozetka is a Cloudflare-protected Angular SPA, so it is queried through the
# official Bright Data MCP server (brightdata_* tools in opencode.json) rather
# than a tool in this server. Token: Bright Data → Settings → API Tokens.
# Used by the `brightdata` remote MCP server ({env:BRIGHT_DATA_API_KEY});
# the model drives a remote browser (scraping_browser_* tools) to render
# Rozetka. Free tier: 5 000 req/month. Without it, Rozetka is skipped —
# OLX / Hotline / Prom work with no token at all.
BRIGHT_DATA_API_KEY=

# Optional: disable specific marketplaces by comma-separated names
# (olx, hotline, prom). Empty = all enabled.
MARKETUA_DISABLE_PROVIDERS=
